  "description": "ATEL MCP server health: tool call rate, error rate, latency p99, dispatch denials, platform upstream errors. Drives ops on-call.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "iteration": 1714905600000,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Throughput & Errors",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Tool calls / sec (5m avg)",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 1},
      "id": 1,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(rate(atel_mcp_tool_calls_total[5m]))", "refId": "A"}
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 200}
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Error rate (5m)",
      "description": "errors / total. Pages oncall above 5%.",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 1},
      "id": 2,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(atel_mcp_tool_calls_total{status=\"error\"}[5m])) / clamp_min(sum(rate(atel_mcp_tool_calls_total[5m])), 0.0001)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.02},
              {"color": "red", "value": 0.05}
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "p99 latency (5m)",
      "description": "Tool handler p99 in ms. >5s pages.",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 1},
      "id": 3,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(atel_mcp_tool_duration_ms_bucket[5m])))",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1000},
              {"color": "red", "value": 5000}
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Scope denials / sec (5m)",
      "description": "Tool calls rejected at scope check. Spike usually means client misconfig.",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 1},
      "id": 4,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(rate(atel_mcp_dispatch_total{scope_check=\"denied\"}[5m]))", "refId": "A"}
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value"
      },
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "type": "row",
      "title": "Tool call breakdown",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 7},
